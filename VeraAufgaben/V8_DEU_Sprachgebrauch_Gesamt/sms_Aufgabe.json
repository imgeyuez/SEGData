    "tasks": [
        {
            "id": "T1",
            "description": "Deine Freundin ist mit ihrer Klasse auf einer Klassenfahrt. Sie schickt dir eine SMS.",
            "image": "sms_Aufgabe.png",
            "questions": [
                {
                    "id": "Q1",
                    "added_multiplechoice": true,
                    "question_type": "text and diagram understanding",
                    "text": "In dieser SMS wird eine verkürzte Sprache verwendet. Es fehlen im ersten Satz zwei wesentliche Satzglieder. Welche sind diese?",
                    "answers": [
                        "A: Subjekt und Objekt",
                        "B: Prädikat und Artikel",
                        "C: Subjekt und Prädikat",
                        "D: Adverbiale Bestimmung und Objekt"
                    ],
                    "gold_answer": "C"
                },
                {
                    "id": "Q2",
                    "added_multiplechoice": true,
                    "question_type": "text and diagram understanding",
                    "text": "Viele Wörter stammen aus dem Englischen. Welche der folgenden Wörter sind aus dem Englischen?",
                    "answers": [
                        "A: abgespacete und Teacher",
                        "B: chillen und ziemlich",
                        "C: völlig und angesagt",
                        "D: Heute und abgespacete"
                    ],
                    "gold_answer": "A"
                },
                {
                    "id": "Q3",
                    "added_multiplechoice": true,
                    "question_type": "text and diagram understanding",
                    "text": "Am Ende der SMS sieht man typische Merkmale der Kurzsprache. Welche sind diese?",
                    "answers": [
                        "A: Name und Symbole/Smileys/Emoticons",
                        "B: Abkürzungen",
                        "C: Symbole/Smileys/Emoticons und Abkürzungen",
                        "D: Abkürzungen und Name"
                    ],
                    "gold_answer": "C"
                },
                {
                    "id": "Q4",
                    "added_multiplechoice": true,
                    "question_type": "text and diagram understanding",
                    "text": "Als du einem Klassenkameraden die SMS vorliest, bekommt ein Passant das mit. Er schimpft, dass die deutsche Sprache vor dem Abgrund stehe. Welche zwei Aspekte würdest du nicht als „Rechtfertigung“ für die Verwendung von SMS - Sprache sehen?",
                    "answers": [
                        "A: Es geht nur darum, für den Empfänger verständlich zu sein",
                        "B: Eine SMS hat eine begrenzte Zeichenanzahl",
                        "C: SMS-Sprache verbessert die Rechtschreibkompetenz.",
                        "D: Es geht darum, möglichst schnell zu schreiben."
                    ],
                    "gold_answer": "C"
                }
            ]
        }
    ]
}